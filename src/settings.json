{
  "translate_target": "English",
  "hotkeys": [
    {
      "hotkey": "<ctrl>+<alt>+a",
      "label": "Solve",
      "mode": "solve",
      "enabled": true
    },
    {
      "hotkey": "<ctrl>+<alt>+e",
      "label": "Explain",
      "mode": "explain",
      "enabled": false
    },
    {
      "hotkey": "<ctrl>+<alt>+t",
      "label": "Translate",
      "mode": "translate",
      "enabled": false,
      "target": "English"
    },
    {
      "hotkey": "<ctrl>+<alt>+b",
      "label": "Quick Ask",
      "mode": "custom",
      "enabled": false,
      "prompt": "You are a helpful assistant. Answer the user's request directly and concisely -- plain text, no markdown, no code fences, no headings."
    }
  ],
  "show_bar": false,
  "bar_color": "#1a1a2e",
  "bar_alpha": 0.45,
  "bar_font_size": 11,
  "show_wait": true,
  "wait_position": "bottom",
  "wait_color": "#f5f5f5",
  "wait_alpha": 0.65,
  "wait_font_size": 8
}